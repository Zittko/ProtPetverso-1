<!--
  Backup automático (API < 31).
  A sessão criptografada NÃO pode ser restaurada: o arquivo volta, mas a chave do Keystore
  não (ela fica presa ao aparelho/instalação), o que causa AEADBadTagException.
 -->
<full-backup-content>
    <exclude domain="sharedpref" path="user_session.xml"/>
    <exclude domain="sharedpref" path="user_session_fallback.xml"/>
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml"/>
</full-backup-content>