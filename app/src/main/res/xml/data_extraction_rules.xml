<!--
  Backup na nuvem / transferência entre aparelhos (API 31+).
  A sessão criptografada não é portátil (chave do Keystore não migra), então fica de fora.
 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="user_session.xml"/>
        <exclude domain="sharedpref" path="user_session_fallback.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="user_session.xml"/>
        <exclude domain="sharedpref" path="user_session_fallback.xml"/>
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml"/>
    </device-transfer>
</data-extraction-rules>