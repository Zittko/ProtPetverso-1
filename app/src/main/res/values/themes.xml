<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProtPetverso1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ProtPetverso1" parent="Base.Theme.ProtPetverso1">
    </style>

    <!-- Estilo do Active Indicator Corrigido -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Adicionamos o android:color junto com o backgroundTint para garantir compatibilidade com qualquer tema pai -->
        <item name="backgroundTint">#FFE0B2</item>
        <item name="android:color">#FFE0B2</item>
        <item name="android:width">32dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <!-- Chip selecionado (escuro, com X) -->

    <!-- Chip sugestão (claro, com +) -->

    <!-- Estilo do Botão de Criar Tarefa -->

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Theme.PetVerso.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Barra de status visível; conteúdo abaixo do notch -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 28+: não desenhar por cima do furo da câmera -->
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
    <style name="Theme.PetVerso.Splash" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">#f08c4b</item>
        <item name="android:windowSplashScreenBackground">#f08c4b</item>
        <item name="android:statusBarColor">#f08c4b</item>
        <item name="android:navigationBarColor">#f08c4b</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Diálogos de confirmação (Excluir vacina/tarefa): fundo branco, textos pretos -->
    <style name="DialogPetVerso" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_branco</item>
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:colorAccent">#000000</item>
    </style>
</resources>