<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.ProtPetverso1" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.ProtPetverso1" parent="Base.Theme.ProtPetverso1">
    </style>

    <!-- Estilo do Active Indicator Corrigido -->
    <style name="CustomActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <!-- Adicionamos o android:color junto com o backgroundTint para garantir compatibilidade com qualquer tema pai -->
        <item name="backgroundTint">#FFE0B2</item>
        <item name="android:color">#FFE0B2</item>
        <item name="android:width">32dp</item>
        <item name="android:height">32dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Medium</item>
    </style>

    <!-- Chip selecionado (escuro, com X) -->
    <style name="ChipPersonalidadeSelecionado" parent="Widget.MaterialComponents.Chip.Entry">
        <item name="chipBackgroundColor">#DF945D</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="chipIconTint">#FFFFFF</item>
        <item name="closeIconTint">#FFFFFF</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">true</item>
    </style>

    <!-- Chip sugestão (claro, com +) -->
    <style name="ChipPersonalidadeSugestao" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">#F7D4A0</item>
        <item name="android:textColor">#000000</item>
        <item name="chipIconTint">#000000</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipCornerRadius">20dp</item>
        <item name="android:textSize">13sp</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
    </style>

    <!-- Estilo do Botão de Criar Tarefa -->
    <style name="FabSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CantosArrendodados" parent="">
        <item name="cornerRadius">8dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="CircleImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="DiaSemanaHeader">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#000000</item>
    </style>
    <style name="Theme.PetVerso.UCrop" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Barra de status visível; conteúdo abaixo do notch -->
        <item name="android:windowFullscreen">false</item>
        <item name="android:fitsSystemWindows">true</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- API 28+: não desenhar por cima do furo da câmera -->
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
    </style>
</resources>