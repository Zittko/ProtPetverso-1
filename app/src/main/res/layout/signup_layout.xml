<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/signupScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffe8ce"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="#ffe8ce"
            android:scaleType="fitXY"
            android:src="@drawable/baseline_arrow_back"
            app:tint="@color/primary_orange" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Crie sua nova conta PetVerso!"
            android:textColor="#F5A623"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Lembre-se de preencher todos os campos antes de continuar!"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Nome"
            android:textColor="@color/text_orange"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ipEdtNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:boxBackgroundColor="#fffbf6"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#a5713f"
            app:boxStrokeErrorColor="#fd6f28"
            app:endIconMode="clear_text"
            app:endIconTint="@color/primary_orange"
            app:errorIconTint="@color/error"
            app:errorTextColor="@color/error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:hint="Digite seu nome"
                android:inputType="textPersonName"
                android:maxLength="16"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:textColor="@color/black"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="E-mail"
            android:textColor="@color/text_orange"
            android:textSize="15sp" />


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ipEdtCriarEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#a5713f"
            app:boxStrokeErrorColor="#fd6f28"
            app:endIconMode="clear_text"
            app:endIconTint="@color/primary_orange"
            app:errorIconTint="@color/error"
            app:errorTextColor="@color/error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtCriarEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:hint="exemplo@email.com"
                android:inputType="textEmailAddress"
                android:maxLength="50"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:textColor="@color/black"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Senha"
            android:textColor="@color/black"
            android:textColorHint="#AAAAAA"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ipEdtCriarSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#a5713f"
            app:boxStrokeErrorColor="#fd6f28"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary_orange"
            app:errorIconTint="@color/error"
            app:errorTextColor="@color/error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtCriarSenha"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:hint="Insira uma senha"
                android:inputType="textPassword"
                android:maxLength="16"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:textColor="@color/black"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Confirmar senha"
            android:textColor="@color/text_orange"
            android:textSize="14sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ipEdtSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="#a5713f"
            app:boxStrokeErrorColor="#fd6f28"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/primary_orange"
            app:errorIconTint="@color/error"
            app:errorTextColor="@color/error"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtSenha"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:hint="Confirme sua senha"
                android:inputType="textPassword"
                android:maxLength="16"
                android:paddingHorizontal="14dp"
                android:paddingVertical="0dp"
                android:textColor="@color/black"
                android:textColorHint="#AAAAAA"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbTermos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Termos de uso do aplicativo.\ntermos de consentimento."
            android:textColor="#555555"
            android:textSize="13sp"

            app:buttonTint="#F5A623" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbPrivacidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Políticas de Privacidade.\ntermos de consentimento."
            android:textColor="#555555"
            android:textSize="13sp"
            app:buttonTint="@color/primary_orange" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="@color/primary_orange"
            android:text="Cadastrar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:cornerRadius="26dp" />

    </LinearLayout>
</ScrollView>