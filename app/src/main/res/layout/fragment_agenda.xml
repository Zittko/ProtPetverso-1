<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE8CE">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCalendario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#000000"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:id="@+id/conteudoCalendario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="4dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <!-- Título + setas mês + expandir -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <ImageView
                            android:id="@+id/btnMesAnterior"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="Mês anterior"
                            android:padding="6dp"
                            android:src="@drawable/ic_arrow_left"
                            app:tint="#000000" />

                        <TextView
                            android:id="@+id/txtMesAno"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:paddingHorizontal="4dp"
                            android:text="—"
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/btnMesProximo"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="Próximo mês"
                            android:padding="6dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="#000000" />

                    </LinearLayout>

                    <!-- Semana: 7 dias na lista, ~5 visíveis -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerDias"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="true"
                        android:overScrollMode="never"
                        android:paddingHorizontal="0dp" />

                    <!-- Mês expandido -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerMes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingHorizontal="4dp"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/btnExpandirCalendario"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="Expandir calendário"
                        android:padding="6dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="#000000" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtTituloLista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Tarefas do Dia"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSemTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="Nenhuma tarefa neste dia."
                android:textColor="#8D6E63"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTarefas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnNovaTarefa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="Nova tarefa"
        app:backgroundTint="#DF945D"
        app:srcCompat="@drawable/baseline_add"
        app:tint="#FFFFFF" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>