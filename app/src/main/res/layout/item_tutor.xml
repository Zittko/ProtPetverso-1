<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgTutorFoto"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_tutor_foto"
        android:contentDescription="Foto do tutor"
        android:padding="8dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_tutor"
        app:shapeAppearanceOverlay="@style/CircleImageView"
        app:strokeColor="#FF9800"
        app:strokeWidth="1.5dp"
        app:tint="#DF945D" />

    <TextView
        android:id="@+id/txtTutorNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:textColor="#000000"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDesvincularTutor"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:stateListAnimator="@null"
        android:text="Desvincular"
        android:textAllCaps="false"
        android:textColor="#000000"
        android:textSize="12sp"
        android:visibility="gone"
        app:backgroundTint="#F7D4A0"
        app:cornerRadius="8dp"
        app:elevation="0dp" />
</LinearLayout>