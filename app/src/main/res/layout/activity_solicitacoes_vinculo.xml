<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffe8ce">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarSolicitacoes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f08c4b"
        android:title="Solicitações de vínculo"
        android:titleTextColor="@android:color/white" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:gravity="center"
        android:text="Nenhuma solicitação pendente."
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerSolicitacoes"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp"
        android:clipToPadding="false" />
</LinearLayout>