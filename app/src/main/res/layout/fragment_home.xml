<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffe8ce"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="-20dp"
                android:background="#00000000"
                android:scaleType="fitXY"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_orange" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPets"
                android:layout_width="0dp"
                android:layout_height="160dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnProximo"
                android:layout_width="70dp"
                android:layout_height="80dp"
                android:layout_marginHorizontal="-20dp"
                android:background="#00000000"
                android:scaleType="fitXY"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_orange" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtAgendaDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Agenda do Dia"
            android:textColor="@color/text_orange"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTarefas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/txtAlertasSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Alertas de Saúde"
            android:textColor="@color/text_orange"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAlertasSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>