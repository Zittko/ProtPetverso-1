<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE8CE"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Carrossel do pet -->
        <LinearLayout
            android:id="@+id/layoutPet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnAnterior"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Pet anterior"
                android:scaleType="fitXY"
                android:src="@drawable/ic_arrow_left"
                app:tint="@color/text_orange" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPagerPets"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnProximo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Próximo pet"
                android:scaleType="fitXY"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_orange" />
        </LinearLayout>

        <!-- Agenda do Dia -->
        <TextView
            android:id="@+id/txtAgendaDia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="Agenda do Dia"
            android:textColor="@color/text_orange"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSemTarefasHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Não há tarefas para o dia de hoje, consulte a agenda para verificar as próximas tarefas."
            android:textColor="#8D6E63"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Lista de tarefas: não força altura; cards usam wrap_content -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewTarefas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

        <!-- Alertas de Saúde -->
        <TextView
            android:id="@+id/txtAlertasSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="Alertas de Saúde"
            android:textColor="@color/text_orange"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewAlertasSaude"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>