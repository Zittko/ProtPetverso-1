<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#FF9800"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/btnStatus"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/viewStatusBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_status_pendente" />

            <ImageView
                android:id="@+id/imgStatusCheck"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="center"
                android:contentDescription="Concluída"
                android:src="@drawable/ic_check_branco"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleTarefa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/descTarefa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="#555555"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtRodape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="#666666"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:background="@drawable/bg_icon_tarefa"
            android:padding="6dp">

            <ImageView
                android:id="@+id/imgTarefa"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Tipo da tarefa"
                android:scaleType="centerInside" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>