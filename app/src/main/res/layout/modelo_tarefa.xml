<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ModeloCardtarefa"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    app:cardCornerRadius="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ModeloImgTarefa"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center"
            android:scaleType="fitXY"
            android:src="#2c2c2c" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginRight="40dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ModeloTitleTarefa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título da tarefa"
                android:textAlignment="center"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ModeloDescTarefa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:text="Descrição da tarefa, coisas curtas e objetivas de preferência" />

        </LinearLayout>

    </LinearLayout>
    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_marginTop="10dp"
        android:layout_marginRight="10dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="#FFFFFF"
        android:scaleType="fitXY"
        android:src="@drawable/baseline_more_vert"
        android:layout_gravity="top|end"
        app:tint="@color/black" />
</androidx.cardview.widget.CardView>