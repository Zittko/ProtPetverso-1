<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#ffe8ce"
    tools:context=".MenuActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f08c4b"
        android:fitsSystemWindows="false"
        app:menu="@menu/menu_main"
        app:navigationIcon="@drawable/ic_menu"
        app:navigationIconTint="@color/text_orange"
        app:title="Tela Inicial"
        app:titleCentered="true"
        app:titleTextColor="@color/text_orange" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbarMenu"
        android:layout_above="@id/bottomNavbar" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/primary_orange"
        android:fitsSystemWindows="false"
        app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
        app:itemIconTint="@color/text_orange"
        app:itemTextColor="@color/text_orange"
        app:labelMaxLines="1"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>