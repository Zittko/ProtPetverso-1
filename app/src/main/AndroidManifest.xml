<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ProtPetverso1">
        <activity
            android:name=".vaccine.CadastrarVacinaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- ===== LAUNCHER ===== -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.PetVerso.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- ===== ACCOUNT ===== -->
        <activity
            android:name=".account.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".account.SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".user.EditarUsuarioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".account.RecuperarSenhaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".user.CriarUsuarioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" /> <!-- ===== MENU PRINCIPAL ===== -->
        <activity
            android:name=".MenuActivity"
            android:exported="false" /> <!-- ===== PET ===== -->
        <activity
            android:name=".pet.EscolhaPetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pet.PetSignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".pet.MaisInfoPetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" /> <!-- ===== AGENDA ===== -->
        <activity
            android:name=".schedule.CriarTarefaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" /> <!-- ===== UCROP (recorte de foto) ===== -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PetVerso.UCrop" />
        <activity
            android:name=".CenterTitleUCropActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.PetVerso.UCrop" /> <!-- ===== LEGADO (não usada no fluxo) ===== -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".pet.EditarPetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>